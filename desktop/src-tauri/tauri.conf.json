{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moneyhelper",
  "version": "4.27.0",
  "identifier": "com.badhope.moneyhelper",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://127.0.0.1:5198",
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "cd ../frontend && npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "MIT",
    "category": "Finance",
    "shortDescription": "AI finance department: ledger, payables, reconciliation",
    "longDescription": "Moneyhelper: bookkeeping, portfolio risk, research, statements, tax estimates and cash scheduling. Every number computed deterministically and auditable.",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/moneyhelper-server"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Morningstar202604/moneyhelper/releases/latest/download/latest.json",
        "https://gitcode.com/badhope/moneyhelper/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAxNTc0NUFGQTk4QzkxQUIKUldTcmtZeXByMFZYQWJGamdBTjU1S1JYbDU4dndBNVhITHgvZEtMZGxDMnc2aWJtYWJidVVsSVkK"
    }
  }
}
