# 复制为 .env 后按需填写。全部可选：不配置也能跑（确定性模板兜底）。

# 模型（基于 LiteLLM 统一接入，自动故障转移 + 成本追踪）：
#   DeepSeek  https://api.deepseek.com/v1          model: deepseek-chat
#   豆包      https://ark.cn-beijing.volces.com/api/v3   model: 推理接入点 ID
#   通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1  model: qwen-plus
#   OpenAI    https://api.openai.com/v1             model: gpt-4o-mini
#   Anthropic https://api.anthropic.com/v1          model: claude-3-5-sonnet-latest
#   Gemini    https://generativelanguage.googleapis.com/v1beta/openai  model: gemini-2.0-flash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=deepseek-chat

# 访问口令：留空 = 不鉴权（仅限本机/内网使用）；设置后所有 /api/* 需带
# Authorization: Bearer <口令> 或 ?token=<口令>，前端首次访问会提示输入。
API_TOKEN=

# 加密数据库敏感字段（ai_api_key）的启动口令。不设置则敏感字段落库时不加密
# （明文存储，仅适合纯本机使用场景）。8 位以上，首次设置后勿改——改了无法解密旧数据。
# VAULT_PASSPHRASE=

# MCP Server：=1 启动时挂载 /mcp 路径（Streamable HTTP），任何 MCP Client 可接入 Moneyhelper 工具集。
# 设 =0 关闭（纯本机不需要对外暴露 MCP 时）。默认开启。
MCP_ENABLE=1

# 是否允许通过设置页/API 或备份恢复写入 stdio MCP 服务器（默认 0）。
# stdio 会在服务端拉起任意本地进程，属于命令执行能力；只在完全可信的本机
# 部署中打开。需要本地 stdio 服务器时，更安全的做法是手动编辑 data/mcp.json。
# MONEYHELPER_ALLOW_STDIO_MCP=0

# 外部 MCP 工具暴露模式：readonly（默认，只暴露 readOnlyHint=true 的工具）
# 或 all（兼容旧行为，暴露全部工具，仅限完全可信的服务器）。
# MONEYHELPER_MCP_EXTERNAL_TOOLS=readonly

# 审计日志默认只追加，物理清空需显式打开（仅开发/测试；生产请用归档与保留策略）。
# MONEYHELPER_ALLOW_AUDIT_CLEAR=0

# 未设 API_TOKEN 时，额外允许访问的 Host（逗号分隔，默认只放行本机）。
# 例：按局域网主机名访问写 nas.local；需要对外网暴露请直接设 API_TOKEN。
# ALLOWED_HOSTS=nas.local,10.0.0.5

# 调试用：仅放行前端开发源。生产同域托管无需改动。
# CORS_ALLOW_ALL=1

# 数据目录：默认 backend/data/（指向 wealth.db 所在路径 + backups/wal 日志所在路径）。
# MONEYHELPER_DB_PATH=/abs/path/to/wealth.db

# ---------------------------------------------------------------------------
# 账号与登录（多用户 / 家庭共享场景才需要）
# ---------------------------------------------------------------------------
# 首次启动且用户表为空时，用这两个变量自动创建管理员；二者都设才生效。
# 不设也能用：第一个通过界面注册的账号自动成为管理员。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# JWT 签发口令（登录态令牌）。不设则回落到 API_SECRET；
# 生产环境请设一个独立强口令，且不要与 API_TOKEN 相同（启动时会告警）。
# JWT_SECRET=
# 兼容旧变量名（历史上先有 API_SECRET，后拆出 JWT_SECRET）
# API_SECRET=
# 登录态有效期（小时），默认 168（7 天）
# JWT_EXPIRE_HOURS=168

# ---------------------------------------------------------------------------
# 观测与嵌入（可选，不配则对应能力自动降级）
# ---------------------------------------------------------------------------
# Phoenix / Langfuse 追踪上报端；不设则观测完全 no-op，不影响功能
# PHOENIX_ENDPOINT=
# 长期记忆的向量嵌入模型（走 LiteLLM 统一接入），默认 text-embedding-3-small
# EMBED_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# 行情数据源（可选）
# ---------------------------------------------------------------------------
# 东财搜索接口的 token；留空用内置公开值。仅在该公开值失效时才需要改。
# EASTMONEY_SEARCH_TOKEN=

# ---------------------------------------------------------------------------
# 测试/调试专用（生产环境勿设）
# ---------------------------------------------------------------------------
# =1 关闭限流。仅用于 e2e / 压测：整轮测试在 1 分钟内会发 200+ 请求，
# 不关会撞上默认 200 次/分钟的上限。
# MONEYHELPER_DISABLE_RATE_LIMIT=1

# 部署在可信反代（nginx/Caddy）之后时设 =1：登录限流按 X-Forwarded-For 取真实客户端 IP。
# 直连暴露端口时不要开——该头可伪造，开了等于把按 IP 的防爆破交出去。
# MONEYHELPER_TRUST_PROXY=1
