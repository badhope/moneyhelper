{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.badhope/moneyhelper",
  "description": "Local-first AI finance department: bookkeeping, portfolio risk, research, statements, tax estimates, cash scheduling. Every number computed deterministically and auditable.",
  "version": "4.8.0",
  "repository": {
    "url": "https://github.com/badhope/moneyhelper",
    "source": "github"
  },
  "websiteUrl": "https://gitcode.com/badhope/moneyhelper",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "moneyhelper",
      "version": "4.8.0",
      "transport": {
        "type": "stdio",
        "command": "python",
        "args": ["-m", "app.mcp_server", "stdio"]
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "http://127.0.0.1:8788/mcp"
    }
  ]
}
